# Copie para .env e preencha.
PORT=3333
# Local: só a própria máquina. No Docker/Railway o Dockerfile define HOST=::
HOST=127.0.0.1

# Postgres local (docker compose). Na Railway, use a DATABASE_URL do Postgres com pgvector.
DATABASE_URL=postgres://personal_ai:personal_ai@localhost:5432/personal_ai

# Gere com: npm run hash-password   (mantenha as aspas simples: o hash contém "$")
APP_PASSWORD_HASH=

# String aleatória com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# URLs do frontend permitidas no CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:3000

# Railway: deixe sem definir (em produção o padrão já é true).
# TRUST_PROXY=true

OPENAI_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

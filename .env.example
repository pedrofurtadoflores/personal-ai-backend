# Copie para .env e preencha.
PORT=3333
# Local: só a própria máquina. No Docker/Railway o Dockerfile define HOST=::
HOST=127.0.0.1

# Postgres local (docker compose). Na Railway, use a DATABASE_URL do Postgres com pgvector.
DATABASE_URL=postgres://personal_ai:personal_ai@localhost:5432/personal_ai

# Gere com: npm run hash-password   (mantenha as aspas simples: o hash contém "$")
APP_PASSWORD_HASH=

# String aleatória com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# URLs do frontend permitidas no CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:3000

# Proxies confiáveis (lista de IPs/CIDRs ou "false"). Em produção o padrão já confia só nas
# faixas privadas de onde o proxy da Railway conecta. Nunca use "true" (aceita IP falsificado).
# TRUST_PROXY=loopback,linklocal,uniquelocal,100.64.0.0/10

# Regex opcional para liberar os previews da Vercel no CORS.
# FRONTEND_URL_PATTERN=^https://personal-ai-frontend-[a-z0-9-]+\.vercel\.app$

# Teto de tentativas de login por minuto somando todos os IPs.
# LOGIN_GLOBAL_MAX_PER_MINUTE=30

OPENAI_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
